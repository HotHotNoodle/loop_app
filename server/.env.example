# Copy to .env (or run `npm run setup` from the repo root, which generates secrets for you).

PORT=4000
# Where the browser loads the app. In dev this is Vite, which proxies /api to the server.
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/loop.db

# Signs Loop's own access tokens (HS256). Use 32+ random characters.
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# --- Single Sign-On (OpenID Connect) ---
# Dev/showcase: the bundled mock UNSW IdP (npm run idp).
# Production: point at UNSW's real IdP, e.g. Microsoft Entra ID:
#   OIDC_ISSUER=https://login.microsoftonline.com/<unsw-tenant-id>/v2.0
OIDC_ISSUER=http://localhost:4001
OIDC_CLIENT_ID=loop-web
OIDC_CLIENT_SECRET=change-me-change-me-change-me
OIDC_SCOPES=openid profile email
ALLOWED_EMAIL_DOMAINS=unsw.edu.au,ad.unsw.edu.au,student.unsw.edu.au

MOCK_IDP_PORT=4001
